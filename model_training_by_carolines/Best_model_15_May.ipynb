    {
      "cell_type": "code",
      "source": [
        "#choosing only first row from original dataset to use it as test set\n",
        "sample_raw = X_test.iloc[[0]]\n",
        "true_value = y_test.iloc[0]\n",
        "\n",
        "#transforming through pipeline-step\n",
        "sample_transformed = pipeline.named_steps[\"preprocess\"].transform(sample_raw) #redoing the preprocessing\n",
        "sample_selected = pipeline.named_steps[\"select\"].transform(sample_transformed) #sending into RandomForestRegressor to get predictions\n",
        "\n",
        "#predictions\n",
        "predicted_stars = pipeline.named_steps[\"regressor\"].predict(sample_selected)\n",
        "\n",
        "print(\"Real Sample Evaluation:\")\n",
        "print(\"Selected repo features (raw):\\n\", sample_raw)\n",
        "print(\"True stars value:\", true_value)\n",
        "print(\"Predicted stars value:\", predicted_stars[0])\n"
